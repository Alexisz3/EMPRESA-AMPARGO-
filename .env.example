# Public production origin, for example https://www.example.com.
# Enables metadataBase, canonical URLs, hreflang, robots sitemap reference and sitemap entries.
NEXT_PUBLIC_SITE_URL=

# Google Analytics 4 Measurement ID. Analytics is not loaded when this is empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Reserved for the future approved form/email provider integration.
QUOTE_DELIVERY_PROVIDER=

# Final approved corporate inbox that should receive quote requests.
QUOTE_DELIVERY_RECIPIENT=
